[Unit]
Description=Ask Lifestyle Medicine API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ask-lifestyle-medicine
Group=ask-lifestyle-medicine
WorkingDirectory=/opt/ask-lifestyle-medicine/current
EnvironmentFile=/etc/ask-lifestyle-medicine/ask-lifestyle-medicine.env
ExecStart=/usr/bin/node --enable-source-maps artifacts/api-server/dist/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target