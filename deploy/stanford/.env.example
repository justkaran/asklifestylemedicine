# Public origins
PUBLIC_URL=https://ask.example.stanford.edu
FACULTY_PUBLIC_URL=https://ask.example.stanford.edu/faculty
PORT=8080
NODE_ENV=production
TRUST_PROXY_HOPS=1

# GCP Cloud SQL PostgreSQL. Store the real value in the Stanford secret manager.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@127.0.0.1:5432/ask_lifestyle_medicine?sslmode=require

# Required for signed application sessions. Generate a long random value.
SESSION_SECRET=REPLACE_ME

# Faculty authentication. Clerk is the currently implemented adapter.
# A Stanford OIDC/SAML adapter must be implemented and security-reviewed before
# changing this value; do not use an unauthenticated fallback.
FACULTY_AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=REPLACE_ME
CLERK_SECRET_KEY=REPLACE_ME
VITE_CLERK_PUBLISHABLE_KEY=REPLACE_ME

# Answer generation. Values are supplied by Stanford; never commit credentials.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=REPLACE_ME

# Embeddings use the direct OpenAI endpoint, never Replit AI Integrations
# (that proxy does not support /v1/embeddings). Keep `local` during development;
# set openai only after reembed-chunks has completed against this configuration.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=384

# Product policy
BILLING_ENABLED=false
SLM_DOMAIN=ask.example.stanford.edu

# Optional email delivery
RESEND_API_KEY=
EMAIL_FROM=

# Optional object storage. Configure only if Faculty uploads use GCS.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=