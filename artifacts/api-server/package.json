{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"if(!process.env.DATABASE_URL){console.error('ERROR: DATABASE_URL is required to run @workspace/api-server tests (the capture-loop test exercises a real Postgres). Provision a database and re-run.');process.exit(1)}\" && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@clerk/express": "^2.1.13",
    "@clerk/shared": "^4.10.0",
    "@distube/ytdl-core": "^4.16.12",
    "@google-cloud/storage": "^7.19.0",
    "@huggingface/transformers": "^4.2.0",
    "@replit/connectors-sdk": "^0.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "agentmail": "^0.5.12",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.3.0",
    "node-cron": "^4.2.1",
    "openai": "^6.36.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.2",
    "sanitize-html": "^2.17.5",
    "stripe": "^22.2.0",
    "stripe-replit-sync": "^1.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "catalog:",
    "xlsx": "^0.18.5"
  }
}
